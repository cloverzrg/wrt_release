# Runtime/kernel prerequisites for installing dae/honk later; no proxy binaries.
# ARM64 Filogic, IPv4/IPv6, Linux >= 6.12.
CONFIG_IPV6=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y

CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# Official engine packages and optional LuCI pages use these dependencies.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_coreutils-timeout=y

# Keep engines, dashboards, UI libraries and service files out of the image.
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_honk is not set
# CONFIG_PACKAGE_honk-core is not set
# CONFIG_PACKAGE_doona is not set
# CONFIG_PACKAGE_doona-lite is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-app-honk is not set
# CONFIG_PACKAGE_luci-lib-daeuniverse is not set
