# Apply last: override the shared presets for JDCloud RE-CP-03 only.
# Use the package manager and repositories of the current ImmortalWrt branch.
CONFIG_USE_APK=y
CONFIG_IPV6=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_luci-app-package-manager=y

# Requested preinstalled applications. Optional eBPF proxies are not preinstalled.
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-passwall=y
# Keep the SmartDNS backend selected by Passwall.
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_dnsmasq-full=y
# Dockerman requires this backend, but not the standalone LuCI terminal page.
CONFIG_PACKAGE_ttyd=y

# Runtime dependencies for installing Tailscale and OpenVPN OpenSSL later.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libcap-ng=y
CONFIG_PACKAGE_liblzo=y
CONFIG_PACKAGE_liblz4=y
CONFIG_PACKAGE_libnl-genl=y
# Build this module with the firmware's kernel to avoid a later ABI mismatch.
CONFIG_PACKAGE_kmod-ovpn-backports=y
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_luci-app-tailscale is not set
# CONFIG_PACKAGE_openvpn-openssl is not set
# CONFIG_PACKAGE_openvpn-mbedtls is not set
# CONFIG_PACKAGE_openvpn-wolfssl is not set
# CONFIG_PACKAGE_luci-app-openvpn is not set
# CONFIG_PACKAGE_luci-app-openvpn-server is not set

# Remove unrelated applications and their independent backends.
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_easytier is not set
# CONFIG_PACKAGE_easytier-noweb is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_lucky is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_appfilter is not set
# CONFIG_PACKAGE_oaf is not set
# CONFIG_PACKAGE_kmod-oaf is not set
# CONFIG_PACKAGE_luci-app-pbr is not set
# CONFIG_PACKAGE_pbr is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_luci-app-quickstart is not set
# CONFIG_PACKAGE_quickstart is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-lib-taskd is not set
# CONFIG_PACKAGE_luci-lib-xterm is not set
# CONFIG_PACKAGE_taskd is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_htop is not set
